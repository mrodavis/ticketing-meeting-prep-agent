{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "build",
    "types": ["node", "jest"]
  },
  "include": ["bin", "lib", "test"],
  "exclude": ["node_modules", "cdk.out", "build"]
}
