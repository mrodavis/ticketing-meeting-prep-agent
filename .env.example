# offline = scripted model, no AWS needed (default). bedrock = Amazon Bedrock.
LLM_MODE=offline

# Bedrock (only read when LLM_MODE=bedrock). Credentials come from the standard AWS
# chain: AWS_PROFILE, env vars, or the task/instance role. Never commit keys.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# Optional Bedrock Guardrail applied to every model call
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# API
STAFF_TOKEN=change-me
# sqlite (default) or postgres. Postgres reads the libpq variables (PGHOST, PGPORT,
# PGUSER, PGPASSWORD, PGDATABASE, PGSSLMODE) or CHECKPOINT_URL. Needs pip install ".[postgres]".
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB=.data/checkpoints.sqlite

# 1 = print one CloudWatch Embedded Metric Format line per run (set by the CDK stack)
EMF_ENABLED=0
# Fixture data is dated; pin "today" so the numbers stay stable
AS_OF_DATE=2026-11-20
